// Reproducible A*/JPS/D* Lite benchmark runner; included after planner code.
namespace benchmark_redesign {
using Clock=chrono::steady_clock;
const vector<string> planners{"AStar","JPS","DStarLite"};
struct Opt{uint64_t seed=20260807ULL;int target=100,maxCandidates=10000,reps=20,warmups=3,pairs=100,minDistance=100,margin=3;string mode="random-static",update="both",out="results/benchmark_redesign",moving="data/movingai/manifest.csv";};
struct I{string family,source,id,hash;Grid g;Coord s,t;double d=-1;uint64_t seed=0;int candidate=-1;I(string f,string so,string n,const Grid&x,Coord a,Coord b):family(move(f)),source(move(so)),id(move(n)),g(x),s(a),t(b){}};
struct R{bool found=false;int cost=-1,expanded=0;vector<Coord>path;};struct T{R r;long long us=0;};struct E{string mode,reason;Coord cell{-1,-1};bool onPath=false,solvable=false,included=false;};
string q(const string&s){string r="\"";for(char c:s)r+=c=='"'?"\"\"":string(1,c);return r+"\"";}string b(bool x){return x?"1":"0";}string ds(double x){if(x<0)return"";ostringstream o;o<<fixed<<setprecision(2)<<x;return o.str();}
uint64_t mix(uint64_t x){x+=0x9e3779b97f4a7c15ULL;x=(x^(x>>30))*0xbf58476d1ce4e5b9ULL;x=(x^(x>>27))*0x94d049bb133111ebULL;return x^(x>>31);}uint64_t derive(uint64_t a,uint64_t b,uint64_t c=0,uint64_t d=0){return mix(a^mix(b)^(mix(c)<<1)^(mix(d)<<2));}
string gh(const Grid&g){uint64_t h=1469598103934665603ULL;for(int x:g.cells){h^=(unsigned char)x;h*=1099511628211ULL;}h^=g.W;h*=1099511628211ULL;h^=g.H;h*=1099511628211ULL;ostringstream o;o<<hex<<setw(16)<<setfill('0')<<h;return o.str();}
bool validPath(const Grid&g,const vector<Coord>&p,Coord s,Coord t,int&cost,string&why){cost=0;if(p.empty()){why="empty_path";return false;}if(!(p.front()==s)||!(p.back()==t)){why="wrong_endpoints";return false;}for(size_t i=1;i<p.size();++i){int dx=p[i].x-p[i-1].x,dy=p[i].y-p[i-1].y,ax=abs(dx),ay=abs(dy);if((!ax&&!ay)||(ax&&ay&&ax!=ay)){why="non_grid_step";return false;}int sx=(dx>0)-(dx<0),sy=(dy>0)-(dy<0);for(int n=1;n<=max(ax,ay);++n){Coord z(p[i-1].x+sx*(n-1),p[i-1].y+sy*(n-1)),v(z.x+sx,z.y+sy);if(g.isBlock(v.x,v.y)){why="blocked_path_cell";return false;}if(sx&&sy&&g.isBlock(z.x+sx,z.y)&&g.isBlock(z.x,z.y+sy)){why="illegal_diagonal";return false;}cost+=sx&&sy?14:10;}}why="";return true;}
bool valid(const Grid&g,Coord s,Coord t,const R&r,string&why){if(!r.found){why="planner_reported_failure";return false;}int c;if(!validPath(g,r.path,s,t,c,why))return false;if(c!=r.cost){why="reported_path_cost_mismatch";return false;}why="";return true;}
R solve(const string&p,Grid&g,Coord s,Coord t){if(p=="AStar"){auto x=astar8(g,s,t);return{x.found,x.pathCost,x.expanded,x.path};}if(p=="JPS"){auto x=JpsSolver(g,s,t).solve();return{x.found,x.pathCost,x.expanded,x.path};}DStarLiteSolver d(g,s,t);auto x=d.solve();return{x.found,x.pathCost,x.expanded,x.path};}
T timed(const string&p,const Grid&in,Coord s,Coord t){Grid g=in;auto z=Clock::now();R r=solve(p,g,s,t);return{move(r),chrono::duration_cast<chrono::microseconds>(Clock::now()-z).count()};}
T repair(const I&i,Coord c){Grid g=i.g;DStarLiteSolver d(g,i.s,i.t);auto initial=d.solve();auto z=Clock::now();d.updateCell(c,true);auto x=d.replan();x.expanded-=initial.expanded;return{{x.found,x.pathCost,x.expanded,x.path},chrono::duration_cast<chrono::microseconds>(Clock::now()-z).count()};}
void help(){cout<<"Usage: path_benchmark --mode random-static|random-dynamic|movingai-static|movingai-dynamic [options]\n"<<"--master-seed N --target-solvable N --max-candidates N --timing-repetitions N --warmup-runs N --dynamic-update-mode local_nonpath|path_blocking|both --movingai-manifest FILE --pairs-per-map N --min-start-goal-distance N --path-margin N --output-dir DIR\n";}
bool ni(const string&s,int&x){try{size_t n;long long v=stoll(s,&n);if(n!=s.size()||v<0||v>INT_MAX)return false;x=(int)v;return true;}catch(...){return false;}}
bool parse(int ac,char**av,Opt&o){for(int i=1;i<ac;++i){string a=av[i];if(a=="--help"){help();return false;}if(a.rfind("--",0)||++i>=ac)return false;string v=av[i];if(a=="--mode")o.mode=v;else if(a=="--dynamic-update-mode")o.update=v;else if(a=="--movingai-manifest")o.moving=v;else if(a=="--output-dir")o.out=v;else if(a=="--master-seed"){try{o.seed=stoull(v);}catch(...){return false;}}else{int*x=nullptr;if(a=="--target-solvable")x=&o.target;else if(a=="--max-candidates")x=&o.maxCandidates;else if(a=="--timing-repetitions")x=&o.reps;else if(a=="--warmup-runs")x=&o.warmups;else if(a=="--pairs-per-map")x=&o.pairs;else if(a=="--min-start-goal-distance")x=&o.minDistance;else if(a=="--path-margin")x=&o.margin;else return false;if(!ni(v,*x))return false;}}return o.target>0&&o.maxCandidates>0&&o.reps>0&&(o.update=="both"||o.update=="local_nonpath"||o.update=="path_blocking");}
void heads(ofstream&m,ofstream&s,ofstream&dm,ofstream&d){m<<"experiment_id,map_family,map_source,grid_width,grid_height,obstacle_density,master_seed,map_seed,candidate_index,map_id,map_hash,start_x,start_y,goal_x,goal_y,initially_solvable,included_in_static_set,exclusion_reason\n";s<<"experiment_id,benchmark_type,map_family,map_id,map_hash,grid_width,grid_height,obstacle_density,start_x,start_y,goal_x,goal_y,planner,repetition,warmup,success,path_cost,expanded_nodes,elapsed_us,correctness_group,path_cost_matches_group,exclusion_reason\n";dm<<"experiment_id,map_family,map_id,map_hash,update_mode,update_x,update_y,update_on_original_path,updated_map_solvable,included_in_dynamic_set,exclusion_reason\n";d<<"experiment_id,map_family,map_id,map_hash,update_mode,planner,phase,repetition,warmup,success,path_cost,expanded_nodes,elapsed_us,path_cost_matches_group,exclusion_reason\n";}
void mr(ofstream&f,const string&e,const I&i,bool ok,bool inc,const string&w){f<<q(e)<<','<<q(i.family)<<','<<q(i.source)<<','<<i.g.W<<','<<i.g.H<<','<<ds(i.d)<<','<<i.seed<<','<<i.seed<<','<<i.candidate<<','<<q(i.id)<<','<<q(i.hash)<<','<<i.s.x<<','<<i.s.y<<','<<i.t.x<<','<<i.t.y<<','<<b(ok)<<','<<b(inc)<<','<<q(w)<<'\n';}
void sr(ofstream&f,const string&e,const I&i,const string&p,int rep,bool warm,const T&v,const string&group,bool match,const string&w){f<<q(e)<<",\"static\","<<q(i.family)<<','<<q(i.id)<<','<<q(i.hash)<<','<<i.g.W<<','<<i.g.H<<','<<ds(i.d)<<','<<i.s.x<<','<<i.s.y<<','<<i.t.x<<','<<i.t.y<<','<<q(p)<<','<<rep<<','<<b(warm)<<','<<b(v.r.found)<<','<<v.r.cost<<','<<v.r.expanded<<','<<v.us<<','<<q(group)<<','<<b(match)<<','<<q(w)<<'\n';}
void dr(ofstream&f,const string&e,const I&i,const E&u,const string&p,const string&phase,int rep,bool warm,const T&v,bool match,const string&w){f<<q(e)<<','<<q(i.family)<<','<<q(i.id)<<','<<q(i.hash)<<','<<q(u.mode)<<','<<q(p)<<','<<q(phase)<<','<<rep<<','<<b(warm)<<','<<b(v.r.found)<<','<<v.r.cost<<','<<v.r.expanded<<','<<v.us<<','<<b(match)<<','<<q(w)<<'\n';}
vector<I> randomMaps(const Opt&o,ofstream&f,const string&e,bool&complete){vector<I>out;complete=true;for(auto wh:vector<pair<int,int>>{{50,50},{100,100},{500,500}})for(double den:vector<double>{.1,.2,.3}){int got=0;for(int c=0;c<o.maxCandidates&&got<o.target;c++){uint64_t seed=derive(o.seed,(uint64_t(wh.first)<<32)|wh.second,llround(den*100),c);Grid g(wh.first,wh.second);g.genRandom((int)(seed&0x7fffffff),(float)den);I x("random","generated","random_"+to_string(wh.first)+"x"+to_string(wh.second)+"_d"+to_string((int)llround(den*100))+"_c"+to_string(c),g,{0,0},{wh.first-1,wh.second-1});x.d=den;x.seed=seed;x.candidate=c;x.hash=gh(g);bool ok=astar8(g,x.s,x.t).found;mr(f,e,x,ok,ok,ok?"":"initially_unsolvable");if(ok){out.push_back(move(x));got++;}}if(got<o.target){complete=false;cerr<<"INCOMPLETE random configuration: "<<got<<'/'<<o.target<<"\n";}}return out;}
bool mapLoad(const string&p,Grid&g,string&w){ifstream f(p);string a;int h,wi;if(!(f>>a)||a!="type"||!(f>>a)||a!="octile"||!(f>>a>>h)||a!="height"||!(f>>a>>wi)||a!="width"||!(f>>a)||a!="map"){w="invalid_octile_header";return false;}string line;getline(f,line);g=Grid(wi,h);for(int y=0;y<h;y++){if(!getline(f,line)||int(line.size())!=wi){w="invalid_map_row";return false;}for(int x=0;x<wi;x++){char c=line[x];if(c=='.'||c=='G')g.cells[g.idx(x,y)]=0;else if(c=='@'||c=='O'||c=='T'||c=='S'||c=='W')g.cells[g.idx(x,y)]=1;else{w="unsupported_terrain";return false;}}}return true;}
vector<I> movingMaps(const Opt&o,ofstream&f,const string&e,bool&complete){vector<I>out;complete=true;ifstream in(o.moving);string line;if(!getline(in,line)){cerr<<"cannot_open_movingai_manifest\n";complete=false;return out;}while(getline(in,line)){if(line.empty()||line[0]=='#')continue;stringstream ss(line);string family,path,id,pairText;getline(ss,family,',');getline(ss,path,',');getline(ss,id,',');getline(ss,pairText,',');int target=o.pairs;if(!pairText.empty()&&!ni(pairText,target)){complete=false;continue;}Grid g(1,1);string w;if(!mapLoad(path,g,w)){cerr<<path<<": "<<w<<'\n';complete=false;continue;}vector<Coord>free;for(int y=0;y<g.H;y++)for(int x=0;x<g.W;x++)if(g.isFree(x,y))free.push_back({x,y});mt19937_64 rng(derive(o.seed,hash<string>{}(id)));int got=0,attempt=0;while(got<target&&attempt<max(1000,target*100)){I x(family,path,id+"_pair"+to_string(attempt),g,free[rng()%free.size()],free[rng()%free.size()]);x.hash=gh(g);x.candidate=attempt;bool far=octileDist(x.s,x.t)>=o.minDistance,ok=far&&astar8(g,x.s,x.t).found;mr(f,e,x,ok,ok,ok?"":(far?"initially_unsolvable":"below_min_start_goal_distance"));if(ok){out.push_back(move(x));got++;}attempt++;}if(got<target){complete=false;cerr<<"INCOMPLETE Moving AI map "<<id<<"\n";}}return out;}
vector<R> initial(const I&i){vector<R>x;for(auto&p:planners){Grid g=i.g;x.push_back(solve(p,g,i.s,i.t));}return x;}bool groupOK(const I&i,const vector<R>&x,string&w){for(auto&r:x)if(!valid(i.g,i.s,i.t,r,w))return false;if(x[0].cost!=x[1].cost||x[0].cost!=x[2].cost){w="initial_path_cost_mismatch";return false;}w="";return true;}
E event(const I&i,const string&mode,const Opt&o){E e;e.mode=mode;auto r=initial(i);if(!groupOK(i,r,e.reason)){e.reason="invalid_initial_group_"+e.reason;return e;}set<Coord>a(r[0].path.begin(),r[0].path.end()),z(r[1].path.begin(),r[1].path.end()),k(r[2].path.begin(),r[2].path.end());vector<Coord>c;for(int y=0;y<i.g.H;y++)for(int x=0;x<i.g.W;x++){Coord v(x,y);bool common=a.count(v)&&z.count(v)&&k.count(v);bool any=a.count(v)||z.count(v)||k.count(v);if(mode=="local_nonpath"&&i.g.isFree(x,y)&&!(v==i.s)&&!(v==i.t)&&!any)c.push_back(v);if(mode=="path_blocking"&&common&&!(v==i.s)&&!(v==i.t)){bool safe=true;for(auto&p:r){auto it=find(p.path.begin(),p.path.end(),v);if(distance(p.path.begin(),it)<o.margin||distance(it,p.path.end())-1<o.margin)safe=false;}if(safe)c.push_back(v);}}if(c.empty()){e.reason="no_eligible_update_cell";return e;}mt19937_64 rng(derive(i.seed?i.seed:hash<string>{}(i.id),hash<string>{}(mode)));shuffle(c.begin(),c.end(),rng);e.cell=c.front();e.onPath=mode=="path_blocking";Grid g=i.g;g.cells[g.idx(e.cell.x,e.cell.y)]=1;e.solvable=astar8(g,i.s,i.t).found;if(!e.solvable){e.reason="updated_map_unreachable";return e;}e.included=true;return e;}
void statRun(const Opt&o,const vector<I>&items,ofstream&f,const string&e){for(auto&i:items){auto ref=initial(i);string w;bool ok=groupOK(i,ref,w);for(auto&p:planners)for(int n=0;n<o.warmups+o.reps;n++){bool warm=n<o.warmups;T v=timed(p,i.g,i.s,i.t);string x;bool good=valid(i.g,i.s,i.t,v.r,x),match=good&&ok&&v.r.cost==ref[0].cost;sr(f,e,i,p,warm?n:n-o.warmups,warm,v,ok?"valid":"invalid",match,match?"":(good?w:x));}}}
bool dynRun(const Opt&o,const vector<I>&items,ofstream&mf,ofstream&f,const string&e){vector<string>m=o.update=="both"?vector<string>{"local_nonpath","path_blocking"}:vector<string>{o.update};map<string,int>got,need;for(auto&i:items)for(auto&u:m)need[i.family+"|"+to_string(i.g.W)+"|"+to_string(i.g.H)+"|"+ds(i.d)+"|"+u]++;for(auto&i:items)for(auto&u:m){E v=event(i,u,o);mf<<q(e)<<','<<q(i.family)<<','<<q(i.id)<<','<<q(i.hash)<<','<<q(u)<<','<<(v.cell.x<0?"":to_string(v.cell.x))<<','<<(v.cell.y<0?"":to_string(v.cell.y))<<','<<b(v.onPath)<<','<<b(v.solvable)<<','<<b(v.included)<<','<<q(v.reason)<<'\n';string key=i.family+"|"+to_string(i.g.W)+"|"+to_string(i.g.H)+"|"+ds(i.d)+"|"+u;if(!v.included||got[key]>=need[key])continue;got[key]++;Grid changed=i.g;changed.cells[changed.idx(v.cell.x,v.cell.y)]=1;auto ref=astar8(changed,i.s,i.t);for(auto&p:planners)for(int n=0;n<o.warmups+o.reps;n++){bool warm=n<o.warmups;T before=timed(p,i.g,i.s,i.t);string iw;bool iv=valid(i.g,i.s,i.t,before.r,iw);dr(f,e,i,v,p,"initial",warm?n:n-o.warmups,warm,before,iv,iw);T after=p=="DStarLite"?repair(i,v.cell):timed(p,changed,i.s,i.t);string aw;bool av=valid(changed,i.s,i.t,after.r,aw),match=av&&after.r.cost==ref.pathCost;dr(f,e,i,v,p,p=="DStarLite"?"repair":"replan",warm?n:n-o.warmups,warm,after,match,match?"":(av?"final_path_cost_mismatch":aw));}}bool ok=true;for(auto&x:need)if(got[x.first]<x.second){cerr<<"INCOMPLETE dynamic configuration "<<got[x.first]<<'/'<<x.second<<"\n";ok=false;}return ok;}
void summaries(const string&d){const string h="experiment_id,benchmark_type,map_family,grid_width,grid_height,obstacle_density,update_mode,planner,independent_map_count,candidate_map_count,solvable_map_count,solvability_rate,timing_repetitions,timing_statistic_per_map,median_elapsed_us,mean_elapsed_us,stddev_elapsed_us,q1_elapsed_us,q3_elapsed_us,p95_elapsed_us,median_expanded_nodes,mean_expanded_nodes,success_rate,notes\n";ofstream(d+"/static_summary.csv")<<h;ofstream(d+"/dynamic_summary.csv")<<h;}
int mainRun(int ac,char**av){Opt o;if(!parse(ac,av,o))return ac>1&&string(av[1])=="--help"?0:2;filesystem::create_directories(o.out);ofstream m(o.out+"/random_map_manifest.csv"),s(o.out+"/static_raw.csv"),dm(o.out+"/dynamic_manifest.csv"),d(o.out+"/dynamic_raw.csv");heads(m,s,dm,d);bool complete=true;string e="benchmark_"+to_string(o.seed);vector<I>x;if(o.mode.rfind("random",0)==0)x=randomMaps(o,m,e,complete);else if(o.mode.rfind("movingai",0)==0)x=movingMaps(o,m,e,complete);else return 2;if(o.mode.find("-static")!=string::npos)statRun(o,x,s,e);else if(o.mode.find("-dynamic")!=string::npos)complete=dynRun(o,x,dm,d,e)&&complete;else return 2;summaries(o.out);cout<<"Raw data written to "<<o.out<<"; run tools/analyze_benchmarks.py --input-dir "<<o.out<<"\n";return complete?0:3;}
} int main(int ac,char**av){return benchmark_redesign::mainRun(ac,av);}